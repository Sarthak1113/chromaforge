{
  "name": "color-mint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "postinstall": "node -e \"const fs = require('fs'); try { let c = fs.readFileSync('node_modules/next/dist/build/swc/index.js', 'utf8'); if (c.includes('let pkgPath = pkg;')) { c = c.replace('let pkgPath = pkg;', 'let pkgPath; try { pkgPath = require.resolve(pkg); } catch { pkgPath = pkg; }'); fs.writeFileSync('node_modules/next/dist/build/swc/index.js', c); } } catch {}\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.14.0",
    "@next/swc-wasm-nodejs": "^15.5.29",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "drizzle-orm": "^0.40.0",
    "framer-motion": "^12.4.7",
    "jotai": "^2.12.1",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "nuqs": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-useanimations": "^3.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.30.4",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
